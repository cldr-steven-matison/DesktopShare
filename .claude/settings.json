{
  "model": "claude-opus-4-8",
  "effortLevel": "high",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/checkin.sh\"",
            "timeout": 60,
            "statusMessage": "Session check-in: git pull + device issue inbox"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-context.sh\"",
            "timeout": 10,
            "statusMessage": "Injecting agent/subagent-rules.md into the sub-agent"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"",
            "timeout": 300,
            "statusMessage": "Checking deploy/commit/claim guard"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/kb-retrieve.sh\"",
            "timeout": 10,
            "statusMessage": "Local KB: retrieving passages for this grep (spark-dd06 only, advisory)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/compress-advise.sh\"",
            "timeout": 5,
            "statusMessage": "Local compress: offering box-side log triage for a bare log dump (spark-dd06 only, advisory)"
          }
        ]
      }
    ]
  }
}
