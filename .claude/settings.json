{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/checkin.sh\"",
            "timeout": 30,
            "statusMessage": "Session check-in: git pull + device issue inbox"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking deploy/commit guard"
          }
        ]
      }
    ]
  }
}
