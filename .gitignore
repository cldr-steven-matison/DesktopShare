# .claude/ is tracked (shared hooks + settings across devices). Exceptions stay
# local: settings.local.json (per-machine permission paths), skills/ (a local
# install copy — the canonical skill source is the top-level skills/ dir),
# .claim-pending (per-session claim-before-work marker written by guard.sh), and
# .nifi-skill-loaded (per-session nifi-and-ai-loaded marker, same shape), and
# .session-issues / .last-tool (per-session comms context for the Telegram pings,
# issue #192).
/.claude/settings.local.json
/.claude/skills/
/.claude/.claim-pending
/.claude/.nifi-skill-loaded.read-noticed
/.claude/.nifi-skill-loaded
/.claude/.session-issues
/.claude/.last-tool
# files/install-192.sh backs up every settings file it replaces, next to the original.
*.pre-192.*
# Local-only working directories — real content kept on disk, never tracked.
/files/tuna-test/
/files/heygen-srm-poc/
/geekom-g1/
/overlays/
# Session byproducts — never content, safe to ignore everywhere. __pycache__ is
# Python bytecode; *:Zone.Identifier is the NTFS "downloaded from the internet"
# alternate-data-stream crumb WSL surfaces as a literal file.
__pycache__/
*:Zone.Identifier
