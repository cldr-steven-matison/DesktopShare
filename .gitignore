# .claude/ is tracked (shared hooks + settings across devices). Two exceptions stay
# local: settings.local.json (per-machine permission paths) and skills/ (a local
# install copy — the canonical skill source is the top-level skills/ dir).
/.claude/settings.local.json
/.claude/skills/
/files/tuna-test/input/
/files/tuna-test/output/
/files/tuna-test/.env.local
/files/tuna-test/__pycache__/
/files/tuna-test/.venv/
/files/tuna-test/Wav2Lip/
/files/tuna-test/voices/
/files/tuna-test/assets/
