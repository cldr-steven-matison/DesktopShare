# .claude/ is tracked (shared hooks + settings across devices). Exceptions stay
# local: settings.local.json (per-machine permission paths), skills/ (a local
# install copy — the canonical skill source is the top-level skills/ dir), and
# .claim-pending (per-session claim-before-work marker written by guard.sh).
/.claude/settings.local.json
/.claude/skills/
/.claude/.claim-pending
# Local-only working directories — real content kept on disk, never tracked.
/files/tuna-test/
/files/heygen-srm-poc/
/geekom-g1/
/overlays/
