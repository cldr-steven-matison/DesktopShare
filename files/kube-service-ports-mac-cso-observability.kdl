// Zellij layout: pinned localhost ports for every service we care about.
//
// Design choice: NO `minikube tunnel`, NO `minikube service` panes.
// - `minikube tunnel` needs sudo, drops LoadBalancer EXTERNAL-IPs to
//   <pending> when it dies, and requires re-fetching URLs every restart.
// - `minikube service <name>` opens throwaway tunnels on ephemeral ports
//   (55xxx) that rotate every launch — you have to re-type them constantly.
//
// Instead: `kubectl port-forward` per service on FIXED loopback ports.
// URLs never change:
//
//   EFM UI          → http://127.0.0.1:10090/efm/ui/
//   CSO Operator App→ http://127.0.0.1:8090/
//   Grafana         → http://127.0.0.1:3000/
//   Kafka bootstrap → 127.0.0.1:9092 (external clients)
//
// If a pane dies, Ctrl-C then it auto-restarts (or `zellij action new-pane`).
layout {
    split_direction "Horizontal"

    // Mount the custom NiFi processors dir into the minikube VM.
    pane {
        command "/opt/homebrew/bin/minikube"
        args "mount" "/Users/steven.matison/Documents/GitHub/NiFi2 Processor Playground/nifi-custom-processors/:/extensions" "--uid" "10001" "--gid" "10001"
    }

    // EFM UI  → http://127.0.0.1:10090/efm/ui/
    pane {
        command "/usr/local/bin/kubectl"
        args "port-forward" "--address" "0.0.0.0" "service/efm" "10090:10090" "-n" "cld-streaming"
    }

    // NiFi UI is served via the nginx Ingress at
    //   https://mynifi-web.mynifi.cfm-streaming.svc.cluster.local/nifi/
    // /etc/hosts maps that name → 127.0.0.1, and `minikube tunnel` binds
    // the ingress on 443. If you need NiFi in the browser, start the
    // tunnel separately: `sudo minikube tunnel`. No pane here because
    // NiFi's pod binds only its cluster-IP interface, so plain
    // `kubectl port-forward` cannot reach it.

    // CSO Operator App → http://127.0.0.1:8090/
    pane {
        command "/usr/local/bin/kubectl"
        args "port-forward" "--address" "0.0.0.0" "service/cso-operator-app" "8090:8090"
    }

    // Grafana → http://127.0.0.1:3000/
    // Point at the Grafana pod's container port (3000) instead of the
    // Service port so this keeps working whether the Service is
    // ClusterIP:80 (Helm default) or LoadBalancer:3000 (our patched form).
    pane {
        command "/usr/local/bin/kubectl"
        args "port-forward" "--address" "0.0.0.0" "deployment/prometheus-grafana" "3000:3000" "-n" "cld-streaming"
    }

    // Kafka bootstrap (external clients on 127.0.0.1:9092)
    pane {
        command "/usr/local/bin/kubectl"
        args "port-forward" "--address" "0.0.0.0" "service/my-cluster-kafka-bootstrap" "9092:9092" "-n" "cld-streaming"
    }
}
