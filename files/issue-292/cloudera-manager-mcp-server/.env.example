# cloudera-manager-mcp-server — example environment.
# Copy to .env and fill in the surfaces you have. A service with no *_BASE_URL/*_URL
# simply has its tools skipped, so a partial estate (e.g. CM-only) works fine.
#
#   set -a; source .env; set +a
#
# --- Cloudera Manager (CM v51) -------------------------------------------------
# Direct:   http://cm-host:7180/api/v51   |   https://cm-host:7183/api/v51
# Via Knox: https://<gateway>/<datahub>/cdp-proxy-api/cm-api/v51
CM_BASE_URL=http://cm-host:7180/api/v51
CM_USER=admin
CM_PASSWORD=
# When set, a Knox JWT is used (Authorization: Bearer) and Basic creds are ignored.
CM_KNOX_TOKEN=
# true | false | /path/to/ca-bundle.pem
CM_VERIFY_SSL=true

# --- YARN ResourceManager (v1) -------------------------------------------------
YARN_RM_URL=http://rm-host:8088/ws/v1/cluster
# Most RM installs are unauthenticated or Kerberos; Basic provided for wire-compat.
YARN_RM_USER=
YARN_RM_PASSWORD=
YARN_RM_VERIFY_SSL=true

# --- YARN NodeManager (v1) -----------------------------------------------------
# Optional. Set to one worker's NM address to enable the per-node tools.
YARN_NM_HOST=
YARN_NM_VERIFY_SSL=true

# --- Ranger (public v2) --------------------------------------------------------
# http://ranger-host:6080  |  https://ranger-host:6182
RANGER_BASE_URL=http://ranger-host:6080
RANGER_USER=admin
RANGER_PASSWORD=
RANGER_VERIFY_SSL=true

# --- Atlas (v2) ----------------------------------------------------------------
# Direct:   http://atlas-host:31000/api/atlas/v2
# Via Knox: https://<gateway>/<datahub>/cdp-proxy-api/atlas/api/atlas/v2
ATLAS_BASE_URL=http://atlas-host:31000/api/atlas/v2
ATLAS_USER=admin
ATLAS_PASSWORD=
ATLAS_KNOX_TOKEN=
ATLAS_VERIFY_SSL=true

# --- Global --------------------------------------------------------------------
# Belt-and-suspenders read-only guard. This server has no write paths; keep true.
CM_MCP_READONLY=true
CM_MCP_TIMEOUT=30
CM_MCP_RETRIES=3
CM_MCP_RETRY_WAIT=2
# stdio | sse
MCP_TRANSPORT=stdio
