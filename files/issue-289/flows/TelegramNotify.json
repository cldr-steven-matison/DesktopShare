      "inheritedParameterContexts": [],
      "parameters": [
        {
          "name": "Telegram Bot Token",
          "value": null,
          "description": "Sensitive \u2014 the shared fleet bot token; set via the API after upload from ~/.env TOKEN (delivered by WindowsDesktop #293). Never inline, never committed.",
          "sensitive": true,
          "provided": false
        },
        {
          "name": "Telegram Chat Id",
          "value": null,
          "description": "Set via the API after upload from ~/.env CHAT_ID; the shared fleet chat.",
          "sensitive": false,
          "provided": false
        },
        {
          "name": "Device Name",
          "value": "NvidiaSpark-1",
          "description": "Roster name prefixed to every message so no caller can drop the fleet attribution (agent/device-comms.md).",
          "sensitive": false,
          "provided": false
        },
        {
          "name": "Telegram Dry Run",
          "value": "true",
          "description": "SendTelegram logs the intended send instead of posting while this is 'true'. Flip to 'false' once the token + chat id are set (after #293).",
          "sensitive": false,
          "provided": false
        }
      ]
    }
  },
