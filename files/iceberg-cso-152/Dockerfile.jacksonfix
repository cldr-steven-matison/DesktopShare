FROM container.repository.cloudera.com/cloudera/cfm-nifi-k8s:3.0.0-b126-nifi_2.6.0.4.3.4.0-234
USER root
COPY jackson-databind-2.20.1-patched.jar /tmp/patched.jar
# Additively replace every jackson-databind-2.20.1.jar in the image (incl. the
# pre-unpacked nifi-cdf-iceberg-nar bundled-dependencies) with the patched jar
# (2.20.1 + the two legacy PropertyNamingStrategy nested classes). Durable: work/ is image rootfs.
RUN set -eu; n=0; \
    for f in $(find /opt/nifi -name "jackson-databind-2.20.1.jar"); do \
      cp /tmp/patched.jar "$f"; chmod 644 "$f"; n=$((n+1)); \
    done; \
    rm -f /tmp/patched.jar; \
    echo "patched $n jackson-databind-2.20.1.jar copies"
USER 1000:0
