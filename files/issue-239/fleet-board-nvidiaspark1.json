{
  "_comment": "Panels to merge into EdgeFlowManager/files/efm-fleet-dashboard.json for NvidiaSpark-1. Two pieces. (1) A seventh heartbeat stat tile for the top 'Fleet' row: the row today holds six tiles at w=4 (x 0..20) filling all 24 columns, so either narrow all seven to w=3 (x 0,3,6,9,12,15,18) or place this one on its own line at y=6 and push every panel below down by 5. (2) A per-device Layer-2 row mirroring the Jetson block (row + scrape stat + load + memory) plus the :9835 host-exporter scrape stat; its y offsets are placeholders, append after the last row. Metric names on :9936 match the Jetson exporter (the same Linux-generic script is deployed); :9835 metric names are whatever ateska/dgx-spark-prometheus exports and get their own panels once the first scrape shows them.",
  "heartbeat_tile": {
    "type": "stat",
    "title": "NvidiaSpark-1 (DGX Spark)",
    "gridPos": { "h": 5, "w": 4, "x": 0, "y": 6 },
    "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
    "targets": [
      { "refId": "A", "expr": "time() - max(efm_heartbeat_lastSeenTime_seconds{agentClass=\"NvidiaSpark-1\"})" }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 120 },
          { "color": "red", "value": 600 }
        ] }
      }
    },
    "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
  },
  "device_row": [
    {
      "type": "row", "title": "NvidiaSpark-1 (DGX Spark GB10) — host via flow-level exporter (Layer 2) + host exporter (Layer 3)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 78 }, "collapsed": false
    },
    {
      "type": "stat", "title": "Spark Scrape (agent :9936)",
      "gridPos": { "h": 7, "w": 4, "x": 0, "y": 79 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [ { "refId": "A", "expr": "up{job=\"nvidiaspark1-minifi-metrics\"}" } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "Spark load (1/5/15)",
      "gridPos": { "h": 7, "w": 10, "x": 4, "y": 79 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "minifi_java_host_load1{job=\"nvidiaspark1-minifi-metrics\"}", "legendFormat": "load1" },
        { "refId": "B", "expr": "minifi_java_host_load5{job=\"nvidiaspark1-minifi-metrics\"}", "legendFormat": "load5" },
        { "refId": "C", "expr": "minifi_java_host_load15{job=\"nvidiaspark1-minifi-metrics\"}", "legendFormat": "load15" }
      ]
    },
    {
      "type": "timeseries", "title": "Spark memory (unified pool, /proc/meminfo)",
      "gridPos": { "h": 7, "w": 10, "x": 14, "y": 79 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "deckbytes" } },
      "targets": [
        { "refId": "A", "expr": "minifi_java_host_mem_total_kb{job=\"nvidiaspark1-minifi-metrics\"}", "legendFormat": "total" },
        { "refId": "B", "expr": "minifi_java_host_mem_free_kb{job=\"nvidiaspark1-minifi-metrics\"}", "legendFormat": "free" }
      ]
    },
    {
      "type": "stat", "title": "Spark Scrape (host :9835)",
      "gridPos": { "h": 7, "w": 4, "x": 0, "y": 86 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [ { "refId": "A", "expr": "up{job=\"nvidiaspark1-host-metrics\"}" } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "NvidiaSpark-1 — seconds since heartbeat",
      "gridPos": { "h": 7, "w": 10, "x": 4, "y": 86 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "refId": "A", "expr": "time() - max(efm_heartbeat_lastSeenTime_seconds{agentClass=\"NvidiaSpark-1\"})" } ]
    },
    {
      "type": "timeseries", "title": "NvidiaSpark-1 — heartbeats/min",
      "gridPos": { "h": 7, "w": 10, "x": 14, "y": 86 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [ { "refId": "A", "expr": "sum(rate(efm_heartbeat_count_total{agentClass=\"NvidiaSpark-1\"}[5m])) * 60" } ]
    }
  ]
}
